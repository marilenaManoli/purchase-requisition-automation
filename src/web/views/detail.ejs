<%- include("partials/head", { title: r.number, refresh: r.state === "inbox" && extracting }) %>
<p class="small"><a href="/">← Inbox</a></p>
<h1><%= r.number %> <span class="badge s-<%= r.state %>"><%= r.state.replace("_", " ") %></span></h1>
<p class="muted">
  <%= r.subject ?? "(no subject)" %> · from <%= r.fromEmail ?? "unknown sender" %>
  <% if (r.sentAt) { %>· sent <%= r.sentAt.slice(0, 16).replace("T", " ") %><% } %>
  <% if (r.filename) { %>· <%= r.filename %><% } %>
</p>
<div class="card">
  <%# Raw output is safe: the SVG is built only from our own constants. %>
  <%- svg %>
  <p class="muted small">Filled box: where this requisition is now. Outlined: states it has passed through (from its history).</p>
</div>
<p>Requester: <strong><%= r.requester ?? "not in the employee master data" %></strong></p>

<% if (msg) { %><div class="card msg"><%= msg %></div><% } %>
<% if (error) { %><div class="card sev-blocks_approval"><%= error %></div><% } %>

<% const isClerk = actor === "clerk"; %>
<% if (r.state === "inbox") { %>
  <div class="card">
    <% if (extracting) { %>
      <p>Extracting with the LLM… this page refreshes by itself (usually 30–60 seconds).</p>
    <% } else { %>
      <p>Waiting in the inbox: extraction hasn't run or the LLM was unreachable (see History).</p>
      <% if (isClerk) { %><form method="post" action="/requisitions/<%= r.id %>/retry"><button>Retry extraction</button></form><% } %>
    <% } %>
  </div>
<% } %>

<% if (r.state === "pending_approval" && actor === r.currentApproverId) { %>
  <div class="card actions">
    <h3>Your decision (step waiting for you)</h3>
    <form method="post" action="/requisitions/<%= r.id %>/approve">
      <input type="text" name="comment" placeholder="Comment (optional)"> <button>Approve</button>
    </form>
    <form method="post" action="/requisitions/<%= r.id %>/reject">
      <input type="text" name="reason" placeholder="Reason (required)" required> <button>Reject</button>
    </form>
  </div>
<% } else if (r.state === "pending_approval" && actor !== r.currentApproverId && !isClerk) { %>
  <div class="card muted">This requisition is not waiting for you<%= actor === r.requesterId ? " (you are the requester and can never approve it)" : "" %>.</div>
<% } %>


<% if (r.poNumber) { %>
  <div class="card msg">Ordered: purchase order <strong><%= r.poNumber %></strong>
    <% if (r.erpWarnings.length > 0) { %><ul class="small"><% for (const w of r.erpWarnings) { %><li>ERP warning: <%= w %></li><% } %></ul><% } %>
  </div>
<% } %>

<% if (isClerk && (r.state === "approved" || r.state === "pending_approval")) { %>
  <div class="card actions">
    <form method="post" action="/requisitions/<%= r.id %>/delivery-date">
      <h3>Requested delivery date <%= r.requestedDeliveryDate ? "(" + r.requestedDeliveryDate + ")" : "(missing: required by the ERP)" %></h3>
      <input type="date" name="date" value="<%= r.requestedDeliveryDate ?? "" %>" required> <button>Save date</button>
      <p class="muted small">The only value that can change after approval: it doesn't change what is bought or for how much.</p>
    </form>
    <% if (r.state === "approved") { %>
      <form method="post" action="/requisitions/<%= r.id %>/order">
        <h3>Order</h3>
        <button <%= r.requestedDeliveryDate ? "" : "disabled" %>>Send to ERP</button>
        <% if (!r.requestedDeliveryDate) { %><span class="muted small">Enter the delivery date first.</span><% } %>
      </form>
      <form method="post" action="/requisitions/<%= r.id %>/pull-back">
        <h3>Correct after approval</h3>
        <input type="text" name="reason" placeholder="Why, e.g. the ERP rejected it (required)" required> <button>Pull back</button>
        <p class="muted small">Any correction must be approved again from step 1.</p>
      </form>
    <% } %>
  </div>
<% } %>

<% if (isClerk && r.state === "pending_approval") { %>
  <div class="card actions">
    <form method="post" action="/requisitions/<%= r.id %>/pull-back">
      <h3>Pull back for correction</h3>
      <input type="text" name="reason" placeholder="Why (required)" required> <button>Pull back</button>
      <p class="muted small">Approval restarts at step 1 after the next submit.</p>
    </form>
  </div>
<% } %>

<% if (isClerk && r.state === "rejected") { %>
  <div class="card actions">
    <form method="post" action="/requisitions/<%= r.id %>/reopen">
      <h3>Reopen after correction</h3>
      <input type="text" name="note" placeholder="What was corrected (required)" required> <button>Reopen</button>
    </form>
  </div>
<% } %>

<% if (r.rejectionReason && r.state === "rejected") { %>
  <div class="card sev-blocks_approval">Rejected: <%= r.rejectionReason %></div>
<% } %>
<% if (r.related) { %>
  <div class="card">Linked as <strong><%= r.related.relation %></strong> of
    <a href="/requisitions/<%= r.related.id %>"><%= r.related.number %></a>. The clerk decides; neither requisition was changed.</div>
<% } %>

<h2>Issues</h2>
<div class="card">
<% if (r.issues.length === 0) { %><p class="muted">No issues.</p><% } else { %>
<table>
  <thead><tr><th>Severity</th><th>Code</th><th>Field</th><th>Message</th><th>Resolved</th></tr></thead>
  <tbody>
  <% for (const i of r.issues) { %>
    <tr class="<%= i.resolvedAt ? "resolved" : "" %>">
      <td><span class="badge sev-<%= i.severity %>"><%= i.severity.replace("_", " ") %></span></td>
      <td class="small"><%= i.code %></td>
      <td class="small"><%= i.field ?? "" %></td>
      <td><%= i.message %></td>
      <td class="small">
        <% if (i.resolvedAt) { %><%= i.resolvedBy %>: <%= i.resolution %>
        <% } else if (isClerk && r.state === "needs_review") { %>
          <form method="post" action="/requisitions/<%= r.id %>/issues/<%= i.id %>/resolve" style="display:flex; gap:4px;">
            <input type="text" name="note" placeholder="Note (required)" required> <button>Resolve</button>
          </form>
        <% } %>
      </td>
    </tr>
  <% } %>
  </tbody>
</table>
<% } %>
</div>

<h2>What was extracted, and what is established</h2>
<p class="muted small">"Established" is what the system uses. "The email says" is what the model read, with the quote it gave as evidence.
  Unverified values are shown but never used.</p>
<div class="card">
<% if (r.extractionFailed) { %><p class="v-unverified">Automatic extraction failed: the values must be entered by the clerk.</p><% } %>
<table>
  <thead><tr><th>Field</th><th>Established</th><th>Status</th><th>The email says</th><th>Evidence</th></tr></thead>
  <tbody>
  <% for (const f of r.fields) { %>
    <tr>
      <td><%= f.label %></td>
      <td><strong><%= f.established ?? "—" %></strong></td>
      <td class="small v-<%= f.status === "not established" ? "not" : f.status %>"><%= f.status === "clerk" ? "set by clerk" : f.status %></td>
      <td><%= f.claim ?? "" %></td>
      <td class="evidence"><%= f.evidence ?? "" %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>

<h2>Line items</h2>
<div class="card">
<% if (r.lines.length === 0) { %><p class="muted">No line items.</p><% } else { %>
<table>
  <thead><tr><th>#</th><th>Description</th><th>Item code</th><th class="num">Qty</th><th>Unit</th><th class="num">Unit price</th><th>Per</th><th class="num">Amount</th><th>Evidence</th></tr></thead>
  <tbody>
  <% for (const l of r.lines) { %>
    <tr>
      <td><%= l.position %></td>
      <td><%= l.description %></td>
      <td class="small"><%= l.itemCode ?? "—" %></td>
      <td class="num"><%= l.quantity ?? "—" %></td>
      <td><%= l.unit ?? "—" %></td>
      <td class="num"><%= l.unitPrice === null ? "—" : formatMoney(l.unitPrice) %></td>
      <td class="small"><%= l.pricePer && l.pricePer !== 1 ? "per " + l.pricePer : "" %></td>
      <td class="num"><%= l.amount === null ? "—" : formatMoney(l.amount) %></td>
      <td class="evidence"><%= l.evidence ?? "" %></td>
    </tr>
  <% } %>
  </tbody>
</table>
<% } %>
</div>

<% if (isClerk && r.state === "needs_review") { %>
<h2>Clerk review</h2>
<div class="card actions">
  <% if (!r.supplierEstablished) { %>
  <form method="post" action="/requisitions/<%= r.id %>/create-supplier">
    <h3>Supplier not in the master data? Create it</h3>
    <p class="muted small">Pre-filled from the email: check every value against the quote first. If the supplier already exists, select it in the form below instead.</p>
    <table>
      <tr><td>Name</td><td><input type="text" name="name" value="<%= r.supplierClaim.name ?? "" %>" required></td></tr>
      <tr><td>VAT ID</td><td><input type="text" name="vatId" value="<%= r.supplierClaim.vatId ?? "" %>" placeholder="empty if none"></td></tr>
      <tr><td>Country</td><td><input type="text" name="country" placeholder="CH" maxlength="2" required></td></tr>
      <tr><td>Currency</td><td><select name="currency"><% for (const cur of ref.fxRatesToChf.keys()) { %><option value="<%= cur %>"><%= cur %></option><% } %></select></td></tr>
      <tr><td>Payment terms (days)</td><td><input type="text" name="paymentTermsDays" value="30" inputmode="numeric" required></td></tr>
    </table>
    <p><button>Create supplier and use it</button></p>
  </form>
  <% } %>

  <form method="post" action="/requisitions/<%= r.id %>/edit">
    <h3>Enter or correct values</h3>
    <p class="muted small">Empty fields keep their current value. Your values replace the model's, are recorded in the history, and all checks run again.</p>
    <table>
      <tr><td>Supplier</td><td><select name="supplierId"><option value="">— keep —</option>
        <% for (const s of ref.suppliers) { %><option value="<%= s.id %>"><%= s.id %> <%= s.name %><%= s.status === "blocked" ? " (BLOCKED)" : "" %></option><% } %></select></td></tr>
      <tr><td>Cost centre</td><td><select name="costCenterCode"><option value="">— keep —</option>
        <% for (const c of ref.costCenters) { %><option value="<%= c.code %>"><%= c.code %> <%= c.name %></option><% } %></select></td></tr>
      <tr><td>Currency</td><td><select name="currency"><option value="">— keep —</option>
        <% for (const cur of ref.fxRatesToChf.keys()) { %><option value="<%= cur %>"><%= cur %></option><% } %></select></td></tr>
      <tr><td>Requested delivery date</td><td><input type="date" name="requestedDeliveryDate"></td></tr>
    </table>
    <h3>Lines</h3>
    <table>
      <thead><tr><th>#</th><th>Description</th><th>Item code</th><th>Qty</th><th>Unit</th><th>Unit price</th><th>Per</th></tr></thead>
      <tbody>
      <% for (const l of r.lines) { const i = l.position - 1; %>
        <tr>
          <td><%= l.position %></td>
          <td><input name="line.<%= i %>.description" placeholder="<%= l.description %>"></td>
          <td><input name="line.<%= i %>.itemCode" placeholder="<%= l.itemCode ?? "" %>"></td>
          <td><input name="line.<%= i %>.quantity" inputmode="decimal" placeholder="<%= l.quantity ?? "missing" %>"></td>
          <td><input name="line.<%= i %>.unit" placeholder="<%= l.unit ?? "missing" %>"></td>
          <td><input name="line.<%= i %>.unitPrice" inputmode="decimal" placeholder="<%= l.unitPrice ?? "missing" %>"></td>
          <td><input name="line.<%= i %>.pricePer" inputmode="decimal" placeholder="<%= l.pricePer ?? 1 %>"></td>
        </tr>
      <% } %>
      <% const n = r.lines.length; %>
        <tr>
          <td class="muted">new</td>
          <td><input name="line.<%= n %>.description" placeholder="Add a line…"></td>
          <td><input name="line.<%= n %>.itemCode"></td>
          <td><input name="line.<%= n %>.quantity" inputmode="decimal"></td>
          <td><input name="line.<%= n %>.unit"></td>
          <td><input name="line.<%= n %>.unitPrice" inputmode="decimal"></td>
          <td><input name="line.<%= n %>.pricePer" inputmode="decimal"></td>
        </tr>
      </tbody>
    </table>
    <p><button>Save and re-check</button></p>
  </form>

  <form method="post" action="/requisitions/<%= r.id %>/submit">
    <h3>Send for approval</h3>
    <% if (r.proposedChain === null) { %>
      <p class="muted">Not possible yet: the amount and the cost centre must be established first.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Step</th><th>Roles</th><th>Approver</th></tr></thead>
        <tbody>
        <% for (const s of r.proposedChain) { %>
          <tr>
            <td><%= s.position %></td>
            <td class="small"><%= s.roles %></td>
            <td>
              <% if (s.approverId) { %><%= s.approver %>
              <% } else { %>
                <select name="assign.<%= s.position %>" required>
                  <option value="">— assign an approver —</option>
                  <% for (const p of people) { if (p.id === r.requesterId) continue; %>
                    <option value="<%= p.id %>"><%= p.name %> · <%= p.role.replace("_", " ") %></option>
                  <% } %>
                </select>
              <% } %>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
      <p class="muted small">All blocking issues must be resolved first. The requester can't be assigned.</p>
      <button>Send for approval</button>
    <% } %>
  </form>

  <form method="post" action="/requisitions/<%= r.id %>/reject">
    <h3>Reject</h3>
    <input type="text" name="reason" placeholder="Reason, e.g. 'duplicate of PR-…' (required)" required> <button>Reject</button>
  </form>
</div>
<% } %>

<h2>Approval chain</h2>
<div class="card">
<% if (r.steps.length === 0) { %>
  <p class="muted">No approval chain yet<%= r.state === "needs_review" ? ": the clerk must resolve the issues first." : "." %></p>
<% } else { %>
<table>
  <thead><tr><th>Round</th><th>Step</th><th>Roles</th><th>Approver</th><th>Status</th><th>Decided</th><th>Comment</th></tr></thead>
  <tbody>
  <% for (const s of r.steps) { %>
    <tr class="<%= s.isCurrent ? "current" : (s.round !== r.currentRound ? "resolved" : "") %>">
      <td><%= s.round %><%= s.round !== r.currentRound ? " (earlier)" : "" %></td>
      <td><%= s.position %></td>
      <td class="small"><%= s.roles %></td>
      <td><%= s.approver %></td>
      <td><%= s.isCurrent ? "waiting (current)" : s.status %></td>
      <td class="small"><%= s.decidedAt ? s.decidedAt.slice(0, 16).replace("T", " ") : "" %></td>
      <td class="small"><%= s.comment ?? "" %></td>
    </tr>
  <% } %>
  </tbody>
</table>
<% } %>
</div>

<% if (r.notes.length > 0) { %>
<h2>Notes from the email</h2>
<p class="muted small">Statements and instructions found in the email. They are information for the clerk, never commands: they change nothing by themselves.</p>
<div class="card">
  <ul>
  <% for (const n of r.notes) { %>
    <li><%= n.note %><% if (n.evidence) { %><div class="evidence"><%= n.evidence %></div><% } %></li>
  <% } %>
  </ul>
</div>
<% } %>

<h2>History</h2>
<div class="card">
<table>
  <thead><tr><th>When</th><th>Who</th><th>From → to</th><th>Why</th></tr></thead>
  <tbody>
  <% for (const a of r.audit) { %>
    <tr>
      <td class="small"><%= a.at.slice(0, 19).replace("T", " ") %></td>
      <td class="small"><%= a.actor %></td>
      <td class="small"><%= a.from_state ?? "—" %> → <%= a.to_state %></td>
      <td><%= a.reason ?? "" %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>

<h2>Source</h2>
<details class="card">
  <summary>The exact text the model read (email headers, body and PDF text)</summary>
  <pre class="source"><%= r.sourceText %></pre>
</details>
<%- include("partials/foot") %>
