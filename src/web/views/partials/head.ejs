<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if (typeof refresh !== "undefined" && refresh) { %><meta http-equiv="refresh" content="4"><% } %>
  <title><%= typeof title !== "undefined" ? title + " · " : "" %>Purchase requisitions</title>
  <style>
    :root { --fg: #1d2330; --muted: #667085; --line: #d9dde5; --bg: #f6f7f9; --card: #fff;
            --red: #b42318; --red-bg: #fef3f2; --amber: #b54708; --amber-bg: #fffaeb; --green: #067647; --green-bg: #ecfdf3; --blue: #175cd3; --blue-bg: #eff8ff; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--fg); background: var(--bg); }
    header { display: flex; align-items: center; gap: 16px; padding: 10px 20px; background: var(--card); border-bottom: 1px solid var(--line); flex-wrap: wrap; }
    header a.home { font-weight: 600; color: var(--fg); text-decoration: none; }
    header nav { display: flex; gap: 12px; }
    header form { margin-left: auto; display: flex; gap: 6px; align-items: center; }
    main { padding: 20px; max-width: 1200px; margin: 0 auto; }
    h1 { font-size: 20px; margin: 0 0 4px; } h2 { font-size: 16px; margin: 24px 0 8px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; }
    th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { font-size: 12px; color: var(--muted); font-weight: 600; }
    td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .muted { color: var(--muted); } .small { font-size: 12px; }
    .badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; white-space: nowrap; border: 1px solid transparent; }
    .s-inbox, .s-extracted { background: var(--bg); border-color: var(--line); }
    .s-needs_review { background: var(--amber-bg); color: var(--amber); }
    .s-pending_approval { background: var(--blue-bg); color: var(--blue); }
    .s-approved, .s-ordered { background: var(--green-bg); color: var(--green); }
    .s-rejected { background: var(--red-bg); color: var(--red); }
    .v-verified { color: var(--green); } .v-unverified { color: var(--red); } .v-clerk { color: var(--blue); } .v-not { color: var(--muted); }
    .sev-blocks_approval { background: var(--red-bg); color: var(--red); }
    .sev-blocks_order { background: var(--amber-bg); color: var(--amber); }
    .sev-warning { background: var(--bg); color: var(--muted); border-color: var(--line); }
    .evidence { font-family: ui-monospace, Menlo, monospace; font-size: 12px; color: var(--muted); white-space: pre-wrap; }
    .resolved { opacity: .55; }
    .current { background: var(--blue-bg); }
    pre.source { white-space: pre-wrap; font-size: 12px; background: var(--bg); padding: 12px; border-radius: 6px; max-height: 480px; overflow: auto; }
    a { color: var(--blue); }
    select, input, button, textarea { font: inherit; }
    .actions form { margin: 0 0 12px; } .actions h3 { font-size: 14px; margin: 12px 0 6px; }
    .actions input[type=text], .actions textarea { width: 100%; max-width: 520px; }
    .actions table input { width: 100%; min-width: 70px; }
    .msg { background: var(--green-bg); color: var(--green); }
  </style>
</head>
<body>
<header>
  <a class="home" href="/">Purchase requisitions</a>
  <nav>
    <a href="/">Inbox</a>
    <% if (actor !== "clerk") { %><a href="/?mine=1">Waiting for me</a><% } %>
  </nav>
  <form method="post" action="/act-as">
    <label class="muted small" for="actor">Acting as</label>
    <select id="actor" name="actor" onchange="this.form.submit()">
      <option value="clerk" <%= actor === "clerk" ? "selected" : "" %>>Clerk</option>
      <% for (const p of people) { %>
        <option value="<%= p.id %>" <%= actor === p.id ? "selected" : "" %>><%= p.name %> · <%= p.role.replace("_", " ") %></option>
      <% } %>
    </select>
    <noscript><button>Switch</button></noscript>
  </form>
</header>
<main>
