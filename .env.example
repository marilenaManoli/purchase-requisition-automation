# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Web server
PORT=3000

# SQLite database file (created by `npm run seed`)
DB_PATH=./data/app.db

# Local LLM (Ollama). Personal data in emails stays on this machine.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Mock ERP (python3 data/mock_po_api.py)
ERP_URL=http://127.0.0.1:8080
